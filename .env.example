# Bot tokeni (@BotFather)
BOT_TOKEN=123456789:AA...

# PostgreSQL. Railway'da: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/zadachi

# Hisobot oladigan adminlar (vergul bilan)
ADMIN_IDS=111111111

# Kuzatiladigan guruhlar (vergul bilan). Bo'sh qoldirsa ham bo'ladi — guruhda /ulash
GROUP_IDS=

# Vaqt zonasi va tekshiruv vaqti (bir nechta: 13:00,20:00)
TIMEZONE=Asia/Tashkent
REMIND_TIMES=20:00

# Necha kun oldingi checklistlar tekshiriladi
LOOKBACK_DAYS=14

# true — guruhlarga eslatma yuboriladi, false — faqat sizga hisobot
SEND_GROUP_REMINDERS=true
